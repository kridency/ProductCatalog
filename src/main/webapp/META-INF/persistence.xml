<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="productcatalog" transaction-type="RESOURCE_LOCAL">
        <description>Hibernate test case template Persistence Unit</description>
            <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.archive.autodetection" value="class, hbm"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.connection.driver_class" value="org.postgresql.Driver"/>
            <property name="hibernate.connection.url" value="jdbc:postgresql://postgres-container.docker_default:5432/product_db?createDatabaseIfNotExist=true;DB_CLOSE_DELAY=-1"/>
            <property name="hibernate.connection.username" value="intern"/>
            <property name="hibernate.connection.password" value="1gjAVnJ"/>
        </properties>
    </persistence-unit>
</persistence>